# 自动检测文本文件
* text=auto

# Windows 批处理文件必须使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须使用 LF
*.sh text eol=lf

# 源代码文件使用 LF
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# 图片等二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
